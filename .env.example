# Copy to .env and fill in the keys you have.
# Query expansion uses Groq → Gemini → OpenAI (first configured).
# Extraction prefers Gemini (long context + JSON), then OpenAI, then Groq.

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Used only with --citations.
SEMANTIC_SCHOLAR_API_KEY=
