# Copy to .env and fill in the keys you have.
# Query expansion uses Groq → Gemini → OpenAI (first configured).
# Extraction prefers Gemini (long context + JSON), then OpenAI, then Groq.
# Synthesis narration uses the same extraction provider order when --summarize is set.

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Used only with --citations.
SEMANTIC_SCHOLAR_API_KEY=

# Required for LIVE LLM calls in all stages. Read the quotas for your actual
# provider/project/model; blank values intentionally disable live calls.
# Limits are reserved conservatively with an 80% safety factor.
LLM_RPM=
LLM_TPM=
LLM_RPD=
# Optional shared quota name (default: provider, conservatively pooling models).
# LLM_QUOTA_GROUP=my-project
# All local processes/clones using the same quota should share this directory.
# LLM_STATE_DIR=/absolute/shared/path/llm_state

# Optional UI pipeline settings. The UI writes RA_<STAGE>_<FIELD> when saving.
# These are read by the UI runner; existing stage CLIs retain their own flags.
# All editable fields are available in the UI's advanced stage configuration.
# RA_RETRIEVAL_ARTIFACTS_DIR=data/specter2_artifacts
# RA_RETRIEVAL_TOP_K=25
# RA_RETRIEVAL_YEAR_FROM=
# RA_RETRIEVAL_YEAR_TO=
# RA_RETRIEVAL_CATEGORIES=cs.AI,cs.CL
# RA_EXTRACTION_ABSTRACT_ONLY=False
# RA_SYNTHESIS_SUMMARIZE=True
# RA_WRITING_USE_LLM=True
# RA_WRITING_LANGUAGE=vi
# RA_WRITING_TARGET_WORDS=1500
